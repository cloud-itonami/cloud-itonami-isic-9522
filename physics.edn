;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a diagnostic-bench robot assists physical
;; testing and repair of household appliances (ISIC 9522), gated by the
;; Repair Shop Governor. Its physical work here is wheeling a washing
;; machine / refrigerator on an appliance dolly into the workshop bay, and
;; draining the standing water out of a failed washing machine through its
;; emergency drain hose before it is opened.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-9522"
 :cases
 [{:id :appliance-dolly-to-bay
   :kind :transport
   :procedure "robot wheels an 80 kg upright appliance (washer up to refrigerator; the sweep is its centre-of-gravity height) strapped to the dolly from the intake door into the workshop bay and stops at the bay line"
   :params {:mass-kg 35.0 :payload-kg 80.0 :distance-m 25.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :brake-decel-mps2 1.5 :drive-force-n 250.0 :crr 0.02
            :cog-height-m 0.35 :support-half-length-m 0.30
            :max-time-s 1200.0}
   :sweep {:param :payload-cog-height-m :values [0.5 0.7 0.9 1.1 1.3]}
   :quantity :min-tipover-margin
   :limit {:min 0.35 :basis "estimate: keep 35 % of the static stability margin with a tall appliance on the dolly, for strap slack and floor joints"}
   :boundary {:lo 0.2 :hi 3.0}}
  {:id :washer-emergency-drain
   :kind :tank-drain
   :procedure "robot opens the washing machine's emergency drain hose and the standing water in the tub drains by gravity into the tray"
   :params {:tank-area-m2 0.25 :h0-m 0.20 :h-target-m 0.01 :cd 0.62 :dt-s 0.2}
   :sweep {:param :orifice-area-m2 :values [5.03e-5 7.85e-5 1.131e-4 1.767e-4 3.14e-4]}
   :quantity :time-to-target-s
   :limit {:max 300.0 :basis "estimate: tub drained within 5 minutes of intake so the bench slot is not held; the sweep is 8/10/12/15/20 mm hose bores, tub area and water depth are estimates"}
   :boundary {:lo 1.0e-5 :hi 1.0e-3}}]}
